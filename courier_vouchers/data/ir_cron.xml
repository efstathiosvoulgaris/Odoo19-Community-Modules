<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_courier_track" model="ir.cron">
        <field name="name">Courier: ενημέρωση κατάστασης vouchers</field>
        <field name="model_id" ref="model_courier_voucher"/>
        <field name="state">code</field>
        <field name="code">model._cron_track()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_courier_boxnow_lockers" model="ir.cron">
        <field name="name">Courier: ενημέρωση lockers BOX NOW</field>
        <field name="model_id" ref="model_courier_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_boxnow_sync_lockers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
