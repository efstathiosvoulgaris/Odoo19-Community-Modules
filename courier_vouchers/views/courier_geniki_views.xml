<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="courier_account_view_form_geniki" model="ir.ui.view">
        <field name="name">courier.account.form.geniki</field>
        <field name="model">courier.account</field>
        <field name="inherit_id" ref="courier_account_view_form"/>
        <field name="arch" type="xml">
            <!-- Geniki «finalises» instead of issuing a pickup list. -->
            <xpath expr="//button[@name='action_close_day']" position="attributes">
                <attribute name="invisible">not courier_has_pickup_list or courier == 'geniki'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_close_day']" position="after">
                <button name="action_close_day" type="object" string="Οριστικοποίηση Ημέρας"
                        invisible="courier != 'geniki' or not id"
                        confirm="Τα vouchers στέλνονται οριστικά στη Γενική και δεν ακυρώνονται πλέον. Συνέχεια;"/>
            </xpath>
            <xpath expr="//page[@name='credentials']" position="inside">
                <group invisible="courier != 'geniki'" groups="base.group_system">
                    <field name="geniki_test"/>
                    <field name="geniki_username"/>
                    <field name="geniki_password" password="True"/>
                    <field name="geniki_app_key" password="True"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='defaults']" position="inside">
                <group invisible="courier != 'geniki'">
                    <group>
                        <field name="default_weight"/>
                        <field name="default_charge_type" widget="radio"/>
                    </group>
                    <group>
                        <field name="geniki_last_close"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="courier_voucher_view_form_geniki" model="ir.ui.view">
        <field name="name">courier.voucher.form.geniki</field>
        <field name="model">courier.voucher</field>
        <field name="inherit_id" ref="courier_voucher_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pickup_list_ref']" position="after">
                <field name="geniki_job_id" invisible="courier != 'geniki' or not geniki_job_id"/>
            </xpath>
        </field>
    </record>
</odoo>
