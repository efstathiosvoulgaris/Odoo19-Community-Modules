<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="skroutz_accept_wizard_view_form" model="ir.ui.view">
        <field name="name">skroutz.accept.wizard.view.form</field>
        <field name="model">skroutz.accept.wizard</field>
        <field name="arch" type="xml">
            <form string="Accept Order">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="accept_options_hint" widget="text" readonly="1"
                           invisible="not accept_options_hint"/>
                    <field name="pickup_location" required="1"
                           help="Enter the Pickup Location ID from the available options above."/>
                    <field name="pickup_window" required="1"
                           help="Enter the Pickup Window ID from the available options above."/>
                    <field name="number_of_parcels"/>
                </group>
                <footer>
                    <button name="action_confirm_accept" type="object"
                            string="Confirm Accept" class="btn-success"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
