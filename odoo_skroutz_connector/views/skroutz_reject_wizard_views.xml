<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="skroutz_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">skroutz.reject.wizard.view.form</field>
        <field name="model">skroutz.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Order">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="rejection_reason" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Rejection" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
