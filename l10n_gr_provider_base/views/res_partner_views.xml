<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_l10n_gr_prov" model="ir.ui.view">
        <field name="name">res.partner.form.l10n.gr.prov</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!--
                Place ΑΑΗΤ after the VAT field, which lives in the right-hand
                <group> of the partner form alongside category_id.  Using
                category_id as anchor is fragile because it is wrapped in a
                many2many_tags widget; vat is a plain Char and always present.
            -->
            <field name="gemh" position="after">
                <field name="l10n_gr_prov_aaht" string="ΑΑΗΤ"
                       placeholder="π.χ. 1234.Ε00123.0001"
                       invisible="country_code != 'GR'"/>
            </field>
        </field>
    </record>

</odoo>
