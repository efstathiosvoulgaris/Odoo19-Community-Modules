<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Single «myDATA» section in the Accounting top bar: everything the
         provider modules add (documents AND options) lives here, clearly
         separated from the stock Odoo configuration lists.
         Loaded last so every referenced action already exists.
         ══════════════════════════════════════════════════════════════════════ -->

    <record id="action_l10n_gr_prov_vehicle" model="ir.actions.act_window">
        <field name="name">Οχήματα Διακίνησης</field>
        <field name="res_model">l10n.gr.prov.vehicle</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Καταχωρίστε τα οχήματα</p>
            <p>Οι πινακίδες που χρησιμοποιούνται στα Δελτία Αποστολής
               (aadeVehicleNumber).</p>
        </field>
    </record>

    <menuitem id="menu_l10n_gr_prov_root"
              name="myDATA"
              parent="account.menu_finance"
              sequence="40"/>

    <!-- Έγγραφα / ροές -->
    <menuitem id="menu_l10n_gr_prov_dispatch_root"
              name="Ψηφιακή Διακίνηση"
              parent="menu_l10n_gr_prov_root"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_dispatch_notes"
              name="Δελτία Αποστολής"
              parent="menu_l10n_gr_prov_dispatch_root"
              action="action_l10n_gr_prov_dispatch_notes"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_delivery_wizard"
              name="Παραλαβή / Απόρριψη ΔΑ"
              parent="menu_l10n_gr_prov_dispatch_root"
              action="action_l10n_gr_prov_delivery_wizard"
              sequence="20"/>

    <!-- Επιλογές των modules — μαζεμένες, όχι διάσπαρτες στις ρυθμίσεις Odoo -->
    <menuitem id="menu_l10n_gr_prov_config"
              name="Ρυθμίσεις myDATA"
              parent="menu_l10n_gr_prov_root"
              groups="account.group_account_manager"
              sequence="20"/>
    <menuitem id="menu_l10n_gr_prov_cls_default"
              name="Προεπιλογές Χαρακτηρισμού"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_cls_default"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_vehicle"
              name="Οχήματα Διακίνησης"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_vehicle"
              sequence="20"/>
    <menuitem id="menu_l10n_gr_prov_offline_key"
              name="Κλειδιά Offline QR (TF-1)"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_offline_key"
              sequence="30"/>
    <!-- Πύλη προς τις εταιρικές ρυθμίσεις (πάροχος, credentials, auto-send) -->
    <menuitem id="menu_l10n_gr_prov_settings"
              name="Ρυθμίσεις Παρόχου"
              parent="menu_l10n_gr_prov_config"
              action="account.action_account_config"
              groups="base.group_system"
              sequence="40"/>

</odoo>
