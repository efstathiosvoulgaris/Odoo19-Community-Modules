<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Single «myDATA» section in the Accounting top bar: everything the
         provider modules add (documents AND options) lives here, clearly
         separated from the stock Odoo configuration lists.
         Loaded last so every referenced action already exists.
         ══════════════════════════════════════════════════════════════════════ -->

    <record id="action_l10n_gr_prov_vehicle" model="ir.actions.act_window">
        <field name="name">Οχήματα Διακίνησης</field>
        <field name="res_model">l10n.gr.prov.vehicle</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Καταχωρίστε τα οχήματα</p>
            <p>Οι πινακίδες που χρησιμοποιούνται στα Δελτία Αποστολής
               (aadeVehicleNumber).</p>
        </field>
    </record>

    <!-- ── Ημερολόγιο διαβιβάσεων: όλα τα παραστατικά του παρόχου σε μια λίστα ── -->
    <record id="view_l10n_gr_prov_transmission_list" model="ir.ui.view">
        <field name="name">account.move.list.l10n.gr.prov.transmission</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" default_order="l10n_gr_prov_send_datetime desc, id desc">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="l10n_gr_edi_inv_type" optional="show"/>
                <field name="amount_total" sum="Σύνολο"/>
                <field name="l10n_gr_prov_state" widget="badge"
                       decoration-success="l10n_gr_prov_state == 'sent'"
                       decoration-warning="l10n_gr_prov_state in ('to_send', 'queued', 'offline')"
                       decoration-danger="l10n_gr_prov_state == 'error'"/>
                <field name="l10n_gr_prov_mark"/>
                <field name="l10n_gr_prov_send_datetime" optional="show"/>
                <field name="l10n_gr_prov_pdf_uploaded" optional="show" string="PDF"/>
                <field name="l10n_gr_prov_error" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_gr_prov_transmission_search" model="ir.ui.view">
        <field name="name">account.move.search.l10n.gr.prov.transmission</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="l10n_gr_prov_mark"/>
                <filter name="pending" string="Εκκρεμή"
                        domain="[('l10n_gr_prov_state', 'in', ('to_send', 'queued', 'offline'))]"/>
                <filter name="errors" string="Σφάλματα"
                        domain="[('l10n_gr_prov_state', '=', 'error')]"/>
                <filter name="sent" string="Διαβιβασμένα"
                        domain="[('l10n_gr_prov_state', '=', 'sent')]"/>
                <filter name="pdf_pending" string="PDF σε εκκρεμότητα"
                        domain="[('l10n_gr_prov_state', '=', 'sent'), ('l10n_gr_prov_pdf_uploaded', '=', False)]"/>
                <separator/>
                <filter name="filter_invoice_date" string="Ημερομηνία Έκδοσης" date="invoice_date"/>
                <separator/>
                <filter name="group_state" string="Κατάσταση" context="{'group_by': 'l10n_gr_prov_state'}"/>
                <filter name="group_journal" string="Ημερολόγιο" context="{'group_by': 'journal_id'}"/>
                <filter name="group_month" string="Μήνας Έκδοσης" context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_gr_prov_transmissions" model="ir.actions.act_window">
        <field name="name">Διαβιβάσεις myDATA</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_l10n_gr_prov_transmission_list"/>
        <field name="search_view_id" ref="view_l10n_gr_prov_transmission_search"/>
        <field name="domain">[('l10n_gr_prov_state', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Καμία διαβίβαση ακόμη</p>
            <p>Όλα τα παραστατικά που δρομολογούνται μέσω του παρόχου:
               κατάσταση, MARK, ημερομηνία αποστολής και μεταφόρτωση PDF,
               σε μια λίστα για τον έλεγχο του μήνα.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_gr_prov_root"
              name="myDATA"
              parent="account.menu_finance"
              sequence="40"/>

    <menuitem id="menu_l10n_gr_prov_transmissions"
              name="Διαβιβάσεις"
              parent="menu_l10n_gr_prov_root"
              action="action_l10n_gr_prov_transmissions"
              sequence="5"/>

    <!-- Έγγραφα / ροές -->
    <menuitem id="menu_l10n_gr_prov_dispatch_root"
              name="Ψηφιακή Διακίνηση"
              parent="menu_l10n_gr_prov_root"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_dispatch_notes"
              name="Δελτία Αποστολής"
              parent="menu_l10n_gr_prov_dispatch_root"
              action="action_l10n_gr_prov_dispatch_notes"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_delivery_wizard"
              name="Παραλαβή / Απόρριψη ΔΑ"
              parent="menu_l10n_gr_prov_dispatch_root"
              action="action_l10n_gr_prov_delivery_wizard"
              sequence="20"/>

    <!-- Επιλογές των modules — μαζεμένες, όχι διάσπαρτες στις ρυθμίσεις Odoo -->
    <menuitem id="menu_l10n_gr_prov_config"
              name="Ρυθμίσεις myDATA"
              parent="menu_l10n_gr_prov_root"
              groups="account.group_account_manager"
              sequence="20"/>
    <menuitem id="menu_l10n_gr_prov_cls_default"
              name="Προεπιλογές Χαρακτηρισμού"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_cls_default"
              sequence="10"/>
    <menuitem id="menu_l10n_gr_prov_vehicle"
              name="Οχήματα Διακίνησης"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_vehicle"
              sequence="20"/>
    <menuitem id="menu_l10n_gr_prov_offline_key"
              name="Κλειδιά Offline QR (TF-1)"
              parent="menu_l10n_gr_prov_config"
              action="action_l10n_gr_prov_offline_key"
              sequence="30"/>
    <!-- Πύλη προς τις εταιρικές ρυθμίσεις (πάροχος, credentials, auto-send) -->
    <menuitem id="menu_l10n_gr_prov_settings"
              name="Ρυθμίσεις Παρόχου"
              parent="menu_l10n_gr_prov_config"
              action="account.action_account_config"
              groups="base.group_system"
              sequence="40"/>

</odoo>
