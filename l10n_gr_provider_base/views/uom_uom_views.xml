<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AADE «Είδος Ποσότητας» (§8.13) on the unit itself: transmitted on
         dispatch documents. Blank = sent as 7 (Λοιπές Περιπτώσεις) with the
         unit's name. The «Τακτοποίηση» button fills the standard units. -->
    <record id="uom_uom_form_view_l10n_gr_prov" model="ir.ui.view">
        <field name="name">uom.uom.form.l10n.gr.prov</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <group name="uom_details" position="inside">
                <field name="l10n_gr_prov_measurement_unit"/>
            </group>
        </field>
    </record>

    <record id="uom_uom_tree_view_l10n_gr_prov" model="ir.ui.view">
        <field name="name">uom.uom.list.l10n.gr.prov</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_tree_view"/>
        <field name="arch" type="xml">
            <field name="relative_uom_id" position="after">
                <field name="l10n_gr_prov_measurement_unit" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
