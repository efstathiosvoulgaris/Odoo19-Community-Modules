<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_l10n_gr_prov" model="ir.ui.view">
        <field name="name">account.move.form.l10n.gr.prov</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <header position="inside">
                <button name="action_l10n_gr_prov_send" type="object"
                        string="Send to Provider" class="btn-primary"
                        invisible="not l10n_gr_prov_applicable or state != 'posted' or l10n_gr_prov_mark"/>
            </header>

            <notebook position="inside">
                <page string="E-Invoicing Provider" name="l10n_gr_prov"
                      invisible="not l10n_gr_prov_applicable">
                    <group>
                        <group string="Status">
                            <field name="l10n_gr_prov_state" readonly="1"/>
                            <field name="l10n_gr_prov_send_datetime" readonly="1"/>
                            <field name="l10n_gr_prov_error" readonly="1"
                                   invisible="not l10n_gr_prov_error"/>
                            <field name="l10n_gr_prov_previously_submitted" readonly="1"
                                   invisible="not l10n_gr_prov_previously_submitted"/>
                            <field name="l10n_gr_prov_pdf_uploaded" readonly="1"/>
                        </group>
                        <group string="Legal Markings (A.1035/2020)">
                            <field name="l10n_gr_prov_mark" readonly="1"/>
                            <field name="l10n_gr_prov_invoice_id" readonly="1"/>
                            <field name="l10n_gr_prov_verification_hash" readonly="1"/>
                            <field name="l10n_gr_prov_invoice_identifier" readonly="1"/>
                            <field name="l10n_gr_prov_qr_url" widget="url" readonly="1"/>
                            <field name="l10n_gr_prov_provider_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <group string="B2G — Public Contracts (Peppol)">
                        <group>
                            <field name="l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                            <field name="l10n_gr_prov_contract_ref"
                                   invisible="not l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                            <field name="l10n_gr_prov_budget_type"
                                   invisible="not l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                            <field name="l10n_gr_prov_budget_ref"
                                   invisible="not l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                            <field name="l10n_gr_prov_buyer_ref"
                                   invisible="not l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                            <field name="l10n_gr_prov_purchase_order_ref"
                                   invisible="not l10n_gr_prov_b2g" readonly="l10n_gr_prov_mark"/>
                        </group>
                        <group invisible="not l10n_gr_prov_b2g">
                            <field name="l10n_gr_prov_b2g_status" readonly="1"/>
                            <button name="action_l10n_gr_prov_refresh_b2g_status" type="object"
                                    string="Refresh B2G Status" class="btn-secondary"
                                    invisible="not l10n_gr_prov_invoice_id"/>
                        </group>
                    </group>
                </page>
            </notebook>

        </field>
    </record>

    <record id="view_move_tree_l10n_gr_prov" model="ir.ui.view">
        <field name="name">account.move.list.l10n.gr.prov</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="l10n_gr_prov_state" optional="show" widget="badge"
                       decoration-success="l10n_gr_prov_state == 'sent'"
                       decoration-warning="l10n_gr_prov_state == 'to_send'"
                       decoration-danger="l10n_gr_prov_state == 'error'"/>
            </field>
        </field>
    </record>

</odoo>
