<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- myDATA defaults and CPV live in the Accounting tab, not next to the
         price/taxes, so everyday product entry stays stock Odoo. -->
    <record id="product_template_form_l10n_gr_prov" model="ir.ui.view">
        <field name="name">product.template.form.l10n.gr.prov</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Billing-only users could edit these before the move; keep that.
                 The income/expense accounts on this page keep their own groups. -->
            <page name="invoicing" position="attributes">
                <attribute name="groups">account.group_account_readonly,account.group_account_invoice</attribute>
            </page>
            <group name="accounting" position="after">
                <group string="myDATA (Ελλάδα)" name="l10n_gr_prov_mydata">
                    <group>
                        <field name="l10n_gr_prov_product_type_gr"
                               string="Τύπος Προϊόντος"/>
                        <field name="l10n_gr_prov_cls_category"
                               string="Κατηγορία Χαρακτηρισμού (default)"
                               help="Overrides the automatic suggestion from the product type above."/>
                        <field name="l10n_gr_prov_cls_type"
                               string="Κωδικός E3 (default)"
                               help="Overrides the automatic suggestion from the product type above."/>
                    </group>
                    <group>
                        <field name="l10n_gr_prov_cpv" placeholder="e.g. 30237200-1"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

</odoo>
