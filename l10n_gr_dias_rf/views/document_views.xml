<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dias" model="ir.ui.view">
        <field name="name">account.move.form.dias</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="dias_rf_code" invisible="1"/>
                <field name="dias_rf_code_fmt" string="Κωδικός RF"
                       invisible="move_type != 'out_invoice' or not dias_rf_code"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_dias" model="ir.ui.view">
        <field name="name">sale.order.form.dias</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="dias_rf_code_fmt" invisible="not dias_rf_code_fmt"/>
            </field>
        </field>
    </record>

    <record id="view_partner_form_dias" model="ir.ui.view">
        <field name="name">res.partner.form.dias</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="dias_rf_code_fmt" invisible="not dias_rf_code_fmt or parent_id"/>
            </field>
        </field>
    </record>
</odoo>
