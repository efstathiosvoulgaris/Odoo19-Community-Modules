<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_direct_print_log_list" model="ir.ui.view">
        <field name="name">direct.print.log.list</field>
        <field name="model">direct.print.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'error'">
                <field name="create_date" string="Date"/>
                <field name="document_name"/>
                <field name="job_type"/>
                <field name="printer_name"/>
                <field name="copies"/>
                <field name="user_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_direct_print_log_form" model="ir.ui.view">
        <field name="name">direct.print.log.form</field>
        <field name="model">direct.print.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="document_name"/>
                            <field name="job_type"/>
                            <field name="printer_name"/>
                            <field name="copies"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Error Detail" invisible="status == 'success'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_direct_print_log" model="ir.actions.act_window">
        <field name="name">Print Log</field>
        <field name="res_model">direct.print.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
