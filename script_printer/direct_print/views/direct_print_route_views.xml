<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_direct_print_route_list" model="ir.ui.view">
        <field name="name">direct.print.route.list</field>
        <field name="model">direct.print.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="report_display_name" string="Report"/>
                <field name="report_name" string="Technical Name" optional="show"/>
                <field name="printer_name"/>
                <field name="copies"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_direct_print_route_form" model="ir.ui.view">
        <field name="name">direct.print.route.form</field>
        <field name="model">direct.print.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="report_display_name"/>
                        <field name="report_name"/>
                        <field name="printer_name"
                               help="Exact Windows printer name. Leave blank to use the user's selected printer."/>
                        <field name="copies"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_direct_print_routes" model="ir.actions.act_window">
        <field name="name">Print Routes</field>
        <field name="res_model">direct.print.route</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
