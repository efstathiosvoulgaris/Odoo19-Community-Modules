<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Brand field to product form view -->
    <record id="product_template_form_view_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id" options="{'no_create': False}"/>
            </field>
        </field>
    </record>

    <!-- Add Brand column to product list view -->
    <record id="product_template_list_view_brand" model="ir.ui.view">
        <field name="name">product.template.list.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Add Brand to product search view -->
    <record id="product_template_search_view_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id" string="Brand"/>
            </field>
            <filter name="group_by_categ_id" position="after">
                <filter name="group_by_brand_id" string="Brand" context="{'group_by': 'brand_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
