            <div name="button_box" position="inside">
                <button name="action_view_service_contracts" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not service_contract_count">
                    <field name="service_contract_count" widget="statinfo" string="Συμβόλαια"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
