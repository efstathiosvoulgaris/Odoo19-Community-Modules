<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_l10n_gr_prov_ilyda" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.gr.prov.ilyda</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_gr_provider_base.res_config_settings_view_form_l10n_gr_prov"/>
        <field name="arch" type="xml">
            <setting name="l10n_gr_prov_auto_setting" position="after">
                <setting string="ILYDA Credentials" name="l10n_gr_prov_ilyda_setting"
                         help="X-Auth-Key issued by ILYDA support. Username/password only if agreed as the authentication method."
                         invisible="l10n_gr_prov_provider != 'ilyda'">
                    <field name="l10n_gr_prov_ilyda_auth_key" password="True"
                           placeholder="X-Auth-Key"/>
                    <field name="l10n_gr_prov_ilyda_username" placeholder="Username (optional)"/>
                    <field name="l10n_gr_prov_ilyda_password" password="True"
                           placeholder="Password (optional)"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
