<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_l10n_gr_prov_pos_eftpos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.gr.prov.pos.eftpos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_gr_provider_pos.res_config_settings_view_form_l10n_gr_prov_pos"/>
        <field name="arch" type="xml">
            <field name="pos_l10n_gr_prov_walkin_partner_id" position="after">
                <div class="row">
                    <label string="Τερματικό Α.1155" for="pos_l10n_gr_prov_eft_terminal_id"
                           class="col-lg-4 o_light_label"/>
                    <field name="pos_l10n_gr_prov_eft_terminal_id"/>
                </div>
                <div class="row" invisible="not pos_l10n_gr_prov_eft_terminal_id">
                    <field name="pos_l10n_gr_prov_eft_require_signature" class="col-lg-1"/>
                    <label string="Υποχρεωτική υπογραφή Α.1155 για πληρωμές με κάρτα"
                           for="pos_l10n_gr_prov_eft_require_signature" class="col-lg-10 o_light_label"/>
                </div>
                <div class="row" invisible="not pos_l10n_gr_prov_eft_terminal_id">
                    <label string="Μέγιστες δόσεις" for="pos_l10n_gr_prov_eft_max_installments"
                           class="col-lg-4 o_light_label"/>
                    <field name="pos_l10n_gr_prov_eft_max_installments"/>
                </div>
            </field>
        </field>
    </record>

</odoo>
