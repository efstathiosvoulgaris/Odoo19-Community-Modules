<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Δηλώσεις ωραρίου ─────────────────────────────────────────────── -->
    <record id="ergani_wto_view_list" model="ir.ui.view">
        <field name="name">ergani.wto.list</field>
        <field name="model">ergani.wto</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('error', 'unknown', 'expired')"
                  decoration-muted="state == 'simulated'" decoration-info="state == 'draft'">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employee_id"/>
                <field name="kind"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-info="state in ('draft', 'pending', 'sending')"
                       decoration-danger="state in ('error', 'unknown', 'expired')"/>
                <field name="protocol" optional="show"/>
                <field name="submitted_at" optional="show"/>
                <field name="comments" optional="hide"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ergani_wto_view_form" model="ir.ui.view">
        <field name="name">ergani.wto.form</field>
        <field name="model">ergani.wto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" type="object" string="Έλεγχος" invisible="state != 'draft'"
                            groups="hr.group_hr_manager,base.group_system"/>
                    <button name="action_submit" type="object" string="Υποβολή" class="btn-primary"
                            invisible="state != 'draft'" groups="hr.group_hr_manager,base.group_system"
                            confirm="Η δήλωση στέλνεται στο ΕΡΓΑΝΗ και δεν αλλάζει μετά. Για κάθε μέρα ισχύει η τελευταία υποβολή. Συνέχεια;"/>
                    <button name="action_resend" type="object" string="Ξαναστείλε"
                            invisible="state not in ('unknown', 'error')"
                            groups="hr.group_hr_manager,base.group_system"/>
                    <button name="action_copy_draft" type="object" string="Αντιγραφή ως νέο πρόχειρο"
                            invisible="state == 'draft'" groups="hr.group_hr_manager,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,sent"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Προσομοίωση" bg_color="text-bg-secondary"
                            invisible="state != 'simulated'"/>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Αλλαγή ωραρίου: υποβάλλεται <strong>πριν αρχίσει η εργασία της μέρας</strong>. Μετά την
                        έναρξη επιτρέπεται μόνο επέκταση που κρατά το αρχικό ωράριο και αρχίζει αργότερα από την
                        ώρα υποβολής. Εκπρόθεσμη αλλαγή δεν υπάρχει.
                    </div>
                    <group>
                        <group>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="comments" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="environment"/>
                            <field name="protocol"/>
                            <field name="submit_date_raw" invisible="not submit_date_raw"/>
                            <field name="submitted_at"/>
                            <field name="submitted_by_id"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <group string="Σφάλμα" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="category" column_invisible="1"/>
                            <field name="time_from" widget="float_time" invisible="category == 'no_work'"/>
                            <field name="time_to" widget="float_time" invisible="category == 'no_work'"/>
                        </list>
                    </field>
                    <group string="Τεχνικά" groups="base.group_system" invisible="not payload">
                        <field name="payload"/>
                        <field name="payload_hash"/>
                        <field name="response"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ergani_wto_view_search" model="ir.ui.view">
        <field name="name">ergani.wto.search</field>
        <field name="model">ergani.wto</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="protocol"/>
                <filter name="drafts" string="Πρόχειρα" domain="[('state', '=', 'draft')]"/>
                <filter name="problems" string="Προβλήματα" domain="[('state', 'in', ('error', 'unknown', 'expired'))]"/>
                <filter name="submitted" string="Υποβλήθηκαν" domain="[('state', 'in', ('sent', 'simulated'))]"/>
                <separator/>
                <filter name="future" string="Από σήμερα" domain="[('date_to', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_employee" string="Εργαζόμενος" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Κατάσταση" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ergani_wto" model="ir.actions.act_window">
        <field name="name">Δηλώσεις ωραρίου</field>
        <field name="res_model">ergani.wto</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_future': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Καμία αλλαγή ωραρίου</p>
            <p>Το βασικό ωράριο το δηλώνει ο λογιστής. Από εδώ δηλώνετε αλλαγές: άλλη ώρα, σπαστό, τηλεργασία,
               ρεπό, μη εργασία — «Ωράριο → Νέα αλλαγή».</p>
        </field>
    </record>

    <!-- ── Ημερολόγιο (native, no JS) ───────────────────────────────────── -->
    <record id="ergani_wto_line_view_calendar" model="ir.ui.view">
        <field name="name">ergani.wto.line.calendar</field>
        <field name="model">ergani.wto.line</field>
        <field name="arch" type="xml">
            <calendar date_start="date" mode="week" color="employee_id" create="false"
                      quick_create="false" event_open_popup="true">
                <field name="employee_id" filters="1"/>
                <field name="type_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="ergani_wto_line_view_list" model="ir.ui.view">
        <field name="name">ergani.wto.line.list</field>
        <field name="model">ergani.wto.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="category" column_invisible="1"/>
                <field name="time_from" widget="float_time" invisible="category == 'no_work'"/>
                <field name="time_to" widget="float_time" invisible="category == 'no_work'"/>
                <field name="state" widget="badge"/>
                <field name="wto_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ergani_wto_line_view_search" model="ir.ui.view">
        <field name="name">ergani.wto.line.search</field>
        <field name="model">ergani.wto.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="effective" string="Σε ισχύ (υποβλήθηκαν)" domain="[('state', 'in', ('sent', 'simulated'))]"/>
                <filter name="this_week" string="Αυτή την εβδομάδα"
                        domain="[('date', '>=', (context_today() - relativedelta(weekday=0, weeks=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_employee" string="Εργαζόμενος" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ergani_wto_calendar" model="ir.actions.act_window">
        <field name="name">Ημερολόγιο αλλαγών</field>
        <field name="res_model">ergani.wto.line</field>
        <field name="view_mode">calendar,list</field>
        <field name="context">{'search_default_effective': 1}</field>
    </record>

    <!-- ── Wizard ───────────────────────────────────────────────────────── -->
    <record id="ergani_wto_wizard_view_form" model="ir.ui.view">
        <field name="name">ergani.wto.wizard.form</field>
        <field name="model">ergani.wto.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="date_from" readonly="mode == 'extend'"/>
                        <field name="date_to" readonly="mode == 'extend'"/>
                        <field name="current_schedule"/>
                    </group>
                    <group>
                        <field name="day_type" invisible="mode == 'extend'"/>
                        <field name="extend_until" widget="float_time" invisible="mode != 'extend'"
                               required="mode == 'extend'"/>
                        <field name="comments"/>
                    </group>
                </group>
                <field name="interval_ids" invisible="mode == 'extend' or day_type in ('rest', 'no_work')">
                    <list editable="bottom">
                        <field name="time_from" widget="float_time"/>
                        <field name="time_to" widget="float_time"/>
                    </list>
                </field>
                <div class="text-muted" invisible="mode == 'extend'">
                    Σπαστό ωράριο: προσθέστε δεύτερο διάστημα. Για κάθε μέρα του διαστήματος φτιάχνεται η ίδια
                    ανάλυση· μία δήλωση ανά εργαζόμενο.
                </div>
                <div class="text-muted" invisible="mode != 'extend'">
                    Κρατά το σημερινό ωράριο όπως είναι και μεταφέρει τη λήξη της τελευταίας περιόδου. Πρέπει να
                    υποβληθεί <strong>πριν</strong> από την επιπλέον ώρα.
                </div>
                <footer>
                    <button name="action_submit" type="object" string="Υποβολή" class="btn-primary"
                            confirm="Οι δηλώσεις στέλνονται στο ΕΡΓΑΝΗ και δεν αλλάζουν μετά. Συνέχεια;"/>
                    <button name="action_draft" type="object" string="Αποθήκευση ως πρόχειρο"
                            invisible="mode == 'extend'"/>
                    <button string="Άκυρο" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ergani_wto_wizard" model="ir.actions.act_window">
        <field name="name">Νέα αλλαγή ωραρίου</field>
        <field name="res_model">ergani.wto.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'change'}</field>
    </record>

    <record id="action_ergani_wto_extend" model="ir.actions.act_window">
        <field name="name">Παράταση σήμερα</field>
        <field name="res_model">ergani.wto.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'extend'}</field>
    </record>

    <!-- ── Υπηρεσίες ΕΡΓΑΝΗ, τύποι ──────────────────────────────────────── -->
    <record id="ergani_service_view_list" model="ir.ui.view">
        <field name="name">ergani.service.list</field>
        <field name="model">ergani.service</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="kind"/>
                <field name="code"/>
                <field name="ergani_id"/>
                <field name="description"/>
                <field name="parameters" optional="show"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="action_ergani_services" model="ir.actions.act_window">
        <field name="name">Υπηρεσίες ΕΡΓΑΝΗ</field>
        <field name="res_model">ergani.service</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Άγνωστο ακόμα</p>
            <p>Γεμίζει με τη «Δοκιμή σύνδεσης» (trial ή παραγωγικό): ποιες υπηρεσίες και ποιες υποβολές επιτρέπει
               ο λογαριασμός ΕΡΓΑΝΗ. Από εδώ φαίνεται αν μπορούμε να διαβάσουμε δηλωμένο ωράριο και άδειες.</p>
        </field>
    </record>

    <record id="ergani_worktime_type_view_list" model="ir.ui.view">
        <field name="name">ergani.worktime.type.list</field>
        <field name="model">ergani.worktime.type</field>
        <field name="arch" type="xml">
            <list create="false">
                <header>
                    <button name="action_ergani_sync" type="object" string="Από ΕΡΓΑΝΗ" display="always"
                            icon="fa-refresh" groups="base.group_system"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="verified"/>
            </list>
        </field>
    </record>

    <record id="action_ergani_worktime_types" model="ir.actions.act_window">
        <field name="name">Τύποι ωραρίου / αδειών</field>
        <field name="res_model">ergani.worktime.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
