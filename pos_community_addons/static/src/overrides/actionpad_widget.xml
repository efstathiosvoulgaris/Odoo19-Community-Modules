<?xml version='1.0' encoding='utf-8'?>
<templates>

    <!-- Mobile actionpad: remove SelectPartnerButton and Course button -->
    <t t-name="pos_community_addons.ActionpadOverrides"
       t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="replace"/>
        <xpath expr="//button[@t-on-click='()=>this.pos.addCourse()']" position="replace"/>
    </t>

    <!-- Desktop control buttons row: remove SelectPartnerButton and Course button -->
    <t t-name="pos_community_addons.ControlButtonsOverrides"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="replace"/>
        <xpath expr="//button[hasclass('course-btn')]" position="replace"/>
    </t>

    <!-- Desktop ActionpadWidget: remove "New" button (coffee shop doesn't need another-round ordering) -->
    <t t-name="pos_community_addons.RestaurantActionpadNewButton"
       t-inherit="pos_restaurant.ActionpadWidget"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => this.clickNew()']" position="replace"/>
    </t>

</templates>
