<?xml version='1.0' encoding='utf-8'?>
<templates>

    <t t-name="pos_community_addons.PaymentScreenDue"
       t-inherit="point_of_sale.PaymentScreenDue"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="before">
            <div t-if="currentOrder.table_id"
                 class="text-center fw-bold text-dark mb-1"
                 style="font-size: 180%; letter-spacing: 3px;">
                ΤΡΑΠΕΖΙ <t t-esc="currentOrder.table_id.table_name || currentOrder.table_id.table_number"/>
            </div>
        </xpath>
    </t>

    <!-- The «Τιμολόγιο» button used to be deleted here. It is a fiscal feature:
         a customer may ask for a ΤΙΜ instead of an ΑΛΠ, and a deleted node
         cannot be brought back by a setting. Visibility is now the per-till
         option «Έκδοση Τιμολογίου (ΤΙΜ) από το ταμείο»
         (l10n_gr_provider_pos) — untick it for the same result as before. -->

</templates>
