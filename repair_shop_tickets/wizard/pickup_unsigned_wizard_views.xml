<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pickup_unsigned_wizard_form" model="ir.ui.view">
        <field name="name">service.ticket.pickup.unsigned.wizard.form</field>
        <field name="model">service.ticket.pickup.unsigned.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Μόνο όταν το κινητό υπογραφών δεν είναι διαθέσιμο. Η αιτία καταγράφεται στο δελτίο.</p>
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="reason" rows="3"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Παραλήφθηκε χωρίς υπογραφή" type="object" class="btn-primary"/>
                    <button string="Άκυρο" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
