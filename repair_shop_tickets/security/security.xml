<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_service">
        <field name="name">Service Tickets</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_service_ticket_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_service"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_service_ticket_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_service"/>
        <field name="implied_ids" eval="[(4, ref('group_service_ticket_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="service_ticket_rule_user" model="ir.rule">
            <field name="name">Service Ticket: User can see all tickets</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="service_ticket_rule_manager" model="ir.rule">
            <field name="name">Service Ticket: Manager can see all</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_service_ticket_manager'))]"/>
        </record>
    </data>
</odoo>
