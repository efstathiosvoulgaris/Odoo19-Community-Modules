<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_service_ticket_tree" model="ir.ui.view">
        <field name="name">service.ticket.tree</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <list string="Service Tickets"
                  decoration-info="state == 'new'"
                  decoration-warning="state in ('in_progress', 'waiting_for_parts')"
                  decoration-success="state in ('resolved', 'picked_up')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mobile"/>
                <field name="job_type_ids" widget="many2many_tags" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="brand_id" optional="show"/>
                <field name="product_model_id" optional="show"/>
                <field name="total_price" optional="show"/>
                <field name="notified" optional="hide"/>
                <field name="invoice_id" optional="show"/>
                <field name="repair_result" optional="show" widget="badge"
                       decoration-success="repair_result == 'repaired'"
                       decoration-warning="repair_result == 'not_repaired'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('in_progress', 'waiting_for_parts')"
                       decoration-success="state in ('resolved', 'picked_up')"
                       decoration-muted="state == 'cancelled'"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_ticket_form" model="ir.ui.view">
        <field name="name">service.ticket.form</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <form string="Service Ticket">
                <header>
                    <!-- Ένα κύριο κουμπί ανά στάδιο (το επόμενο βήμα), πρώτο από αριστερά· τα
                         δευτερεύοντα δίπλα του· «Ακύρωση» πάντα τελευταίο. -->
                    <!-- Νέο -->
                    <button name="action_in_progress" string="Έναρξη Εργασίας" type="object"
                            class="oe_highlight" invisible="state != 'new'"/>
                    <!-- Σε Εξέλιξη / Αναμονή Ανταλλακτικών -->
                    <button name="action_resolved" string="Επίλυση" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_waiting_for_parts" string="Αναμονή Ανταλλακτικών" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_not_repaired" string="Δεν Επισκευάστηκε" type="object"
                            invisible="state not in ('in_progress', 'waiting_for_parts')"/>
                    <button name="action_in_progress" string="Ήρθαν τα Ανταλλακτικά" type="object"
                            class="oe_highlight" invisible="state != 'waiting_for_parts'"/>
                    <!-- Επιλύθηκε: ειδοποίηση → τιμολόγιο → παραλαβή. Κύριο είναι μόνο το επόμενο. -->
                    <button name="action_viber_ready" string="Viber" type="object" icon="fa-commenting"
                            class="oe_highlight" invisible="state != 'resolved' or notified"/>
                    <button name="action_viber_ready" string="Viber" type="object" icon="fa-commenting"
                            invisible="state != 'resolved' or not notified"/>
                    <button name="action_notify_customer" string="Ενημερώθηκε" type="object"
                            invisible="state != 'resolved' or notified"/>
                    <button name="action_create_invoice" string="Τιμολόγηση" type="object"
                            class="oe_highlight"
                            invisible="invoice_id or state not in ('resolved', 'picked_up') or (state == 'resolved' and not notified)"/>
                    <button name="action_create_invoice" string="Τιμολόγηση" type="object"
                            invisible="invoice_id or state != 'resolved' or notified"/>
                    <button name="action_picked_up" string="Παραλήφθηκε" type="object"
                            class="oe_highlight" invisible="state != 'resolved' or not invoice_id"/>
                    <button name="action_picked_up" string="Παραλήφθηκε" type="object"
                            invisible="state != 'resolved' or invoice_id"/>
                    <button name="action_pickup_unsigned" string="Χωρίς Υπογραφή" type="object"
                            groups="repair_shop_tickets.group_service_ticket_manager"
                            invisible="state != 'resolved'"
                            help="Μόνο όταν το κινητό υπογραφών δεν είναι διαθέσιμο."/>
                    <button name="action_reset_to_in_progress" string="Επαναφορά" type="object"
                            invisible="state != 'resolved'"
                            help="Η επισκευή δεν πέτυχε: το δελτίο γυρίζει σε «Σε Εξέλιξη» και τα ανταλλακτικά επιστρέφουν."/>
                    <!-- Πάντα -->
                    <button name="action_print_receipt" string="Δελτίο Παραλαβής" type="object" icon="fa-print"/>
                    <button name="action_cancelled" string="Ακύρωση" type="object" class="btn-secondary text-danger"
                            confirm="Να ακυρωθεί το δελτίο; Αν έχει πρόχειρο τιμολόγιο, ακυρώνεται κι αυτό."
                            invisible="state in ('cancelled', 'picked_up')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,in_progress,waiting_for_parts,resolved,picked_up"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="Τιμολόγιο" invisible="not invoice_id"/>
                        <button name="action_view_stock_moves" type="object"
                                class="oe_stat_button" icon="fa-cubes"
                                invisible="stock_move_count == 0">
                            <field name="stock_move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Δεν Επισκευάστηκε" bg_color="text-bg-warning"
                            invisible="repair_result != 'not_repaired'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <field name="brand_id"/>
                            <field name="product_model_id"
                                   context="{'default_brand_id': brand_id}"/>
                            <field name="job_type_ids" widget="many2many_tags"/>
                            <field name="employee_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="notified_channel" readonly="notified"/>
                            <field name="notified_date" invisible="not notified"/>
                            <field name="notified_uid" invisible="not notified"/>
                            <field name="notified" invisible="1"/>
                        </group>
                    </group>

                    <group invisible="repair_result != 'not_repaired'">
                        <field name="repair_result" invisible="1"/>
                        <field name="not_repaired_reason"/>
                    </group>

                    <group string="Παράδοση στον Πελάτη"
                           invisible="not pickup_signed_at and not pickup_unsigned_reason">
                        <group>
                            <field name="pickup_signature" widget="image" readonly="1"
                                   invisible="not pickup_signature"
                                   options="{'size': [0, 120]}"/>
                            <field name="pickup_unsigned_reason" invisible="not pickup_unsigned_reason"/>
                        </group>
                        <group>
                            <field name="pickup_signed_at" invisible="not pickup_signed_at"/>
                            <field name="pickup_requested_by" invisible="not pickup_requested_by"/>
                        </group>
                    </group>

                    <group string="Παραλαβή Συσκευής">
                        <field name="intake_condition" rows="3"
                               placeholder="π.χ. γρατζουνιές πίσω, ραγισμένη γωνία οθόνης"/>
                    </group>


                    <separator/>

                    <group>
                        <group>
                            <field name="fixes_needed"
                                   placeholder="Customer Notes"
                                   rows="6"
                                   style="background-color: #f0f0f0;"/>
                        </group>
                        <group>
                            <field name="technician_notes"
                                   placeholder="Technician Notes"
                                   rows="6"
                                   style="background-color: #fff8e1;"/>
                        </group>
                    </group>

                    <separator/>

                    <group>
                        <group>
                            <field name="labor_price"/>
                        </group>
                        <group>
                            <field name="total_price" readonly="1" string="Σύνολο (με ΦΠΑ)"/>
                        </group>
                    </group>

                    <field name="stock_consumed" invisible="1"/>

                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_service_ticket_kanban" model="ir.ui.view">
        <field name="name">service.ticket.kanban</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="brand_id"/>
                <field name="product_model_id"/>
                <field name="state"/>
                <field name="repair_result"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <strong><field name="name"/></strong>
                            <span t-if="record.repair_result.raw_value == 'not_repaired'"
                                  class="badge text-bg-warning">Δεν Επισκευάστηκε</span>
                            <field t-if="record.partner_id.raw_value" name="partner_id"/>
                            <field t-if="record.brand_id.raw_value" name="brand_id"/>
                            <field t-if="record.product_model_id.raw_value" name="product_model_id"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_service_ticket_search" model="ir.ui.view">
        <field name="name">service.ticket.search</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Service Tickets">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="job_type_ids"/>
                <field name="brand_id"/>
                <field name="product_model_id"/>
                <field name="fixes_needed"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="New" name="state_new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Waiting for Parts" name="state_waiting" domain="[('state', '=', 'waiting_for_parts')]"/>
                <filter string="Resolved" name="state_resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Picked Up" name="state_picked_up" domain="[('state', '=', 'picked_up')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('invoice_id', '!=', False)]"/>
                <separator/>
                <filter string="Επισκευάστηκε" name="repaired" domain="[('repair_result', '=', 'repaired')]"/>
                <filter string="Δεν Επισκευάστηκε" name="not_repaired" domain="[('repair_result', '=', 'not_repaired')]"/>
                <separator/>
                <filter string="To Notify" name="to_notify"
                        domain="[('state', '=', 'resolved'), ('notified', '=', False)]"/>
                <group>
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Brand" name="group_by_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Brand List View -->
    <record id="view_service_brand_tree" model="ir.ui.view">
        <field name="name">service.brand.tree</field>
        <field name="model">service.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Brand Form View -->
    <record id="view_service_brand_form" model="ir.ui.view">
        <field name="name">service.brand.form</field>
        <field name="model">service.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <field name="product_model_ids">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Brand Action -->
    <record id="action_service_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">service.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Job Type List View -->
    <record id="view_service_job_type_tree" model="ir.ui.view">
        <field name="name">service.job.type.tree</field>
        <field name="model">service.job.type</field>
        <field name="arch" type="xml">
            <list string="Job Types" editable="bottom">
                <field name="name"/>
                <field name="product_id"/>
                <field name="list_price" readonly="1" invisible="not product_id"/>
            </list>
        </field>
    </record>

    <!-- Job Type Form View -->
    <record id="view_service_job_type_form" model="ir.ui.view">
        <field name="name">service.job.type.form</field>
        <field name="model">service.job.type</field>
        <field name="arch" type="xml">
            <form string="Job Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="list_price" readonly="1" invisible="not product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Job Type Action -->
    <record id="action_service_job_type" model="ir.actions.act_window">
        <field name="name">Job Types</field>
        <field name="res_model">service.job.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
