<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Service Tickets -->
    <record id="action_service_ticket" model="ir.actions.act_window">
        <field name="name">Service Tickets</field>
        <field name="res_model">service.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_service_ticket_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first service ticket!
            </p>
            <p>
                Track customer issues and manage their progress.
            </p>
        </field>
    </record>

    <!-- Top Menu Item -->
    <menuitem id="menu_service_ticket_root"
              name="Service Tickets"
              web_icon="repair_shop_tickets,static/description/icon.png"
              sequence="100"/>

    <!-- Tickets Menu -->
    <menuitem id="menu_service_ticket_tickets"
              name="Tickets"
              parent="menu_service_ticket_root"
              sequence="10"/>

    <menuitem id="menu_service_ticket_all_tickets"
              name="All Tickets"
              parent="menu_service_ticket_tickets"
              action="action_service_ticket"
              sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_service_ticket_config"
              name="Configuration"
              parent="menu_service_ticket_root"
              sequence="100"/>

    <menuitem id="menu_service_ticket_brands"
              name="Brands &amp; Models"
              parent="menu_service_ticket_config"
              action="action_service_brand"
              sequence="10"/>

    <menuitem id="menu_service_job_types"
              name="Job Types"
              parent="menu_service_ticket_config"
              action="action_service_job_type"
              sequence="20"/>
</odoo>
