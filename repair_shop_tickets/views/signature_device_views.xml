<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_signature_device_list" model="ir.ui.view">
        <field name="name">service.signature.device.list</field>
        <field name="model">service.signature.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="paired"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="view_service_signature_device_form" model="ir.ui.view">
        <field name="name">service.signature.device.form</field>
        <field name="model">service.signature.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pair" string="Σύζευξη" type="object" class="oe_highlight"
                            invisible="paired"/>
                    <button name="action_pair" string="Νέα Σύζευξη" type="object"
                            invisible="not paired"
                            help="Νέος κωδικός. Το κινητό που είναι ήδη συνδεδεμένο δουλεύει μέχρι να συζευχθεί άλλο."/>
                    <button name="action_unpair" string="Αποσύνδεση" type="object" class="text-danger"
                            invisible="not paired"
                            confirm="Το κινητό σταματά να δέχεται αιτήματα υπογραφής μέχρι νέα σύζευξη. Συνέχεια;"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Αρχειοθετημένη" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                            <field name="paired"/>
                        </group>
                        <group>
                            <field name="paired_at"/>
                            <field name="paired_by"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_signature_device" model="ir.actions.act_window">
        <field name="name">Συσκευές Υπογραφής</field>
        <field name="res_model">service.signature.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Προσθέστε το κινητό του ταμείου</p>
            <p>Μετά πατήστε «Σύζευξη» και πληκτρολογήστε τον κωδικό στην εφαρμογή υπογραφών.</p>
        </field>
    </record>
</odoo>
