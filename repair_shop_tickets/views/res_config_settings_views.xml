<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- «Επισκευές»: every option of the module on one settings page of its
         own, opened from Service Tickets → Configuration → Ρυθμίσεις. -->
    <record id="res_config_settings_view_form_repair" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.repair.shop.tickets</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Επισκευές" name="repair_shop_tickets"
                     logo="/repair_shop_tickets/static/description/icon.png">

                    <block title="Τιμολόγηση" name="repair_invoicing_block">
                        <setting string="Τιμές Δελτίου με ΦΠΑ" name="repair_prices_tax_setting"
                                 help="Ναι (προεπιλογή): οι τιμές ανταλλακτικών και εργασίας στο δελτίο είναι τελικές, όπως στο ταμείο. Όχι: είναι καθαρές και ο ΦΠΑ προστίθεται στο σύνολο, στο δελτίο παραλαβής και στο τιμολόγιο. Το σύνολο του δελτίου δείχνει πάντα το ποσό με ΦΠΑ.">
                            <field name="repair_prices_include_tax"/>
                        </setting>
                        <setting string="Προεπιλεγμένη Εργασία" name="repair_labor_product_setting"
                                 help="Η υπηρεσία που μπαίνει στη γραμμή εργασίας του τιμολογίου — από αυτήν παίρνει ΦΠΑ, λογαριασμό εσόδων και χαρακτηρισμό myDATA. Ένας τύπος εργασίας με δικό του είδος έχει προτεραιότητα, και η τιμή του συμπληρώνει την τιμή εργασίας του δελτίου.">
                            <field name="repair_labor_product_id"
                                   options="{'no_create': True}"/>
                            <div class="mt8">
                                <button name="%(action_service_job_type)d" type="action"
                                        string="Τύποι Εργασίας" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                        <setting string="Ημερολόγια Παραστατικών" name="repair_journals_setting"
                                 help="Σε ποιο ημερολόγιο ανοίγει το τιμολόγιο της επισκευής. Κενό = αυτόματα: ΑΛΠ ή Τιμολόγιο Πώλησης όταν υπάρχουν ανταλλακτικά, ΑΠΥ ή Τιμολόγιο Παροχής Υπηρεσιών όταν είναι μόνο εργασία. Επιχείρηση = πελάτης εταιρεία ή με ΑΦΜ.">
                            <div class="row mt16">
                                <label string="Ιδιώτες" for="repair_journal_retail_id" class="col-lg-4 o_light_label"/>
                                <field name="repair_journal_retail_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label string="Επιχειρήσεις" for="repair_journal_business_id" class="col-lg-4 o_light_label"/>
                                <field name="repair_journal_business_id" options="{'no_create': True}"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Ανταλλακτικά" name="repair_parts_block">
                        <setting string="Θέση Ανταλλακτικών" name="repair_location_setting"
                                 help="Από ποια θέση αποθήκης βγαίνουν τα ανταλλακτικά. Κενό = η κύρια θέση (WH/Stock).">
                            <field name="repair_location_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Αφαίρεση από την Αποθήκη" name="repair_consume_setting"
                                 help="Πότε τα ανταλλακτικά του δελτίου βγαίνουν από την αποθήκη. Αν η επισκευή αποτύχει ή το δελτίο ακυρωθεί, επιστρέφουν αυτόματα.">
                            <field name="repair_consume_on" widget="radio"/>
                        </setting>
                    </block>

                    <block title="Πελάτες" name="repair_customers_block">
                        <setting string="Υπενθύμιση Μη Παραλαβής" name="repair_reminder_setting"
                                 help="Μετά από τόσες ημέρες σε «Επιλύθηκε» χωρίς παραλαβή, μπαίνει δραστηριότητα στον τεχνικό να ξαναειδοποιήσει τον πελάτη. 0 = καμία υπενθύμιση.">
                            <field name="repair_pickup_reminder_days"/>
                            <span class="o_light_label ms-2">ημέρες</span>
                        </setting>
                        <setting string="Όροι στο Δελτίο Παραλαβής" name="repair_terms_setting"
                                 help="Τυπώνονται στο δελτίο παραλαβής της συσκευής. Κενό = οι προεπιλεγμένοι όροι (backup, χρέωση ελέγχου, εγγύηση, εγκατάλειψη μετά από 90 ημέρες…).">
                            <field name="repair_receipt_terms"/>
                        </setting>
                    </block>

                    <block title="Υπογραφή Παραλαβής" name="repair_signature_block">
                        <setting string="Συσκευή Υπογραφής" name="repair_signature_device_setting"
                                 help="Το κινητό όπου υπογράφει ο πελάτης όταν παραλαμβάνει τη συσκευή. Χωρίς συσκευή το «Παραλήφθηκε» γίνεται χωρίς υπογραφή, όπως πριν.">
                            <field name="repair_signature_device_id"/>
                        </setting>
                        <setting string="Φράσεις πάνω από την υπογραφή" name="repair_sign_text_setting">
                            <div class="content-group">
                                <div><label for="repair_sign_text_repaired" string="Επισκευάστηκε"/>
                                    <field name="repair_sign_text_repaired" class="w-100"/></div>
                                <div><label for="repair_sign_text_not_repaired" string="Δεν Επισκευάστηκε"/>
                                    <field name="repair_sign_text_not_repaired" class="w-100"/></div>
                            </div>
                        </setting>
                    </block>

                    <block title="Μηνύματα Viber" name="repair_viber_block">
                        <setting string="Έτοιμη Συσκευή" name="repair_viber_ready_setting"
                                 help="Το κείμενο του κουμπιού «Viber: Έτοιμη Συσκευή». Ανοίγει το Viber στη συνομιλία με τον πελάτη και το στέλνει ο υπάλληλος. Πεδία: {customer} {device} {ticket} {amount} {company}">
                            <field name="repair_viber_ready_text" class="w-100"/>
                        </setting>
                        <setting string="Δεν Επισκευάστηκε" name="repair_viber_not_repaired_setting"
                                 help="Το ίδιο κουμπί Viber, όταν η συσκευή επιστρέφεται χωρίς επισκευή. Πεδία: {customer} {device} {ticket} {amount} {company}">
                            <field name="repair_viber_not_repaired_text" class="w-100"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <record id="action_repair_settings" model="ir.actions.act_window">
        <field name="name">Ρυθμίσεις Επισκευών</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'repair_shop_tickets', 'bin_size': False}</field>
    </record>

</odoo>
