<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ΤΙΜ (explicit Τιμολόγιο): the legal document is the downloaded PDF —
         no thermal receipt. ΑΛΠ/ΠΛΑ keep the receipt as the legal print. -->
    <t t-name="l10n_gr_provider_pos.ReceiptScreen"
       t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print')][1]" position="attributes">
            <attribute name="t-if">!currentOrder.l10n_gr_prov_timologio</attribute>
        </xpath>
        <xpath expr="//button[hasclass('print')][2]" position="attributes">
            <attribute name="t-if">pos.config.basic_receipt and !currentOrder.l10n_gr_prov_timologio</attribute>
        </xpath>
        <xpath expr="//OrderReceipt" position="attributes">
            <attribute name="t-if">!currentOrder.l10n_gr_prov_timologio</attribute>
        </xpath>
        <xpath expr="//OrderReceipt" position="before">
            <div t-if="currentOrder.l10n_gr_prov_timologio"
                 class="alert alert-info m-3 text-center">
                Εκδόθηκε Τιμολόγιο <t t-out="currentOrder.l10n_gr_prov_doc_name"/> —
                το PDF είναι το νόμιμο παραστατικό (κατέβηκε αυτόματα).
            </div>
        </xpath>
    </t>

</templates>
