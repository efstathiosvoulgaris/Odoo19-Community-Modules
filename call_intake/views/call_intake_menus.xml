<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The configured project's board; a server action because the project
         is a setting, not a fixed record. -->
    <record id="action_call_intake_board" model="ir.actions.server">
        <field name="name">Αιτήματα Πελατών</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">
project = env.company._call_intake_project()
action = env['ir.actions.act_window']._for_xml_id('project.act_project_project_2_project_task_all')
action.update({
    'name': project.name or 'Αιτήματα Πελατών',
    'domain': [('project_id', '=', project.id)],
    'context': {'default_project_id': project.id, 'active_id': project.id,
                'search_default_open_tasks': 1},
})
        </field>
    </record>

    <menuitem id="menu_call_intake_root" name="Αιτήματα"
              web_icon="call_intake,static/description/icon.svg"
              sequence="45" groups="base.group_user"/>
    <menuitem id="menu_call_intake_board" name="Αιτήματα Πελατών"
              parent="menu_call_intake_root" action="action_call_intake_board" sequence="1"/>
    <menuitem id="menu_call_intake_new" name="Νέο Τηλεφώνημα"
              parent="menu_call_intake_root" action="action_call_intake_wizard" sequence="2"/>
    <menuitem id="menu_call_intake_config" name="Διαμόρφωση"
              parent="menu_call_intake_root" sequence="90" groups="base.group_system"/>
    <menuitem id="menu_call_intake_settings" name="Ρυθμίσεις"
              parent="menu_call_intake_config" action="action_call_intake_settings" sequence="1"/>
</odoo>
