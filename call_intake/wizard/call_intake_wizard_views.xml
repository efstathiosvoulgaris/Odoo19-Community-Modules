<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="call_intake_wizard_view_form" model="ir.ui.view">
        <field name="name">call.intake.wizard.form</field>
        <field name="model">call.intake.wizard</field>
        <field name="arch" type="xml">
            <form string="Νέο Τηλεφώνημα">
                <field name="candidate_partner_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="phone" widget="phone" placeholder="π.χ. 6912345678"
                               default_focus="1"/>
                        <!-- one match is filled in; several narrow the choice;
                             none leaves every contact selectable -->
                        <field name="partner_id"
                               domain="candidate_partner_ids and [('id', 'in', candidate_partner_ids)] or []"
                               options="{'no_create': True}"/>
                        <field name="partner_name" invisible="partner_id"
                               placeholder="Μόνο αν είναι νέος πελάτης"/>
                    </group>
                    <group>
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="date_deadline"/>
                    </group>
                </group>
                <field name="description" nolabel="1"
                       placeholder="Τι ζητάει ο πελάτης — η πρώτη γραμμή γίνεται τίτλος"/>
                <div invisible="not open_task_ids" class="mt-3">
                    <div class="alert alert-warning mb-1" role="alert">
                        Ο πελάτης έχει ήδη ανοιχτά αιτήματα — μήπως είναι για
                        κάποιο από αυτά;
                    </div>
                    <field name="open_task_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="stage_id"/>
                            <field name="date_deadline"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Καταχώριση"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Άκυρο" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_call_intake_wizard" model="ir.actions.act_window">
        <field name="name">Νέο Τηλεφώνημα</field>
        <field name="res_model">call.intake.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
