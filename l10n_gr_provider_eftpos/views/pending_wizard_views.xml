<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eft_pending_wizard_form" model="ir.ui.view">
        <field name="name">l10n.gr.prov.eft.pending.wizard.form</field>
        <field name="model">l10n.gr.prov.eft.pending.wizard</field>
        <field name="arch" type="xml">
            <form string="Εκκρεμείς συναλλαγές τερματικού">
                <div class="alert alert-info" role="status">
                    Οι ανοιχτές πληρωμές του Odoo σε αυτό το τερματικό (προφόρτωση, διακοπή
                    επικοινωνίας), ελεγμένες μία-μία στο τερματικό. «Εκκρεμεί στο Odoo»: το τερματικό
                    έχει αποτέλεσμα — καταχωρείται με «Καταχώριση». «Δεν βρέθηκε στο τερματικό»: το
                    τερματικό δεν τη γνωρίζει· ελέγξτε το και, αν δεν χρεώθηκε, «Δεν χρεώθηκε».
                </div>
                <field name="result" invisible="not result" class="alert alert-warning d-block" nolabel="1"/>
                <field name="line_ids" nolabel="1">
                    <list decoration-info="match_state == 'to_apply'" decoration-warning="match_state == 'not_found'">
                        <field name="txn_time"/>
                        <field name="amount"/>
                        <field name="tip_amount" optional="hide"/>
                        <field name="response_code"/>
                        <field name="description" optional="show"/>
                        <field name="card_number" optional="show"/>
                        <field name="payment_id"/>
                        <field name="match_state" widget="badge"/>
                        <field name="ecr_reference" optional="hide"/>
                        <field name="nsp_reference" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" class="btn-primary"
                            string="Καταχώριση" invisible="not to_apply_count"/>
                    <button name="action_refresh" type="object" string="Ανανέωση" class="btn-secondary"/>
                    <button string="Κλείσιμο" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
