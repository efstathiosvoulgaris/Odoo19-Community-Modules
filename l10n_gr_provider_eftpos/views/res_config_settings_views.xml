<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_l10n_gr_prov_eftpos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n.gr.prov.eftpos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_gr_provider_base.res_config_settings_view_form_l10n_gr_prov"/>
        <field name="arch" type="xml">
            <block name="l10n_gr_prov_send_block" position="after">
                <block title="Πληρωμές με Κάρτα (EFT/POS, Α.1155)" name="l10n_gr_prov_eft_block">
                    <setting string="MegEftPos Driver" name="l10n_gr_prov_eft_driver_setting"
                             help="Η υπηρεσία MegEftPosRestServices που χρεώνει αυτόματα τα τερματικά. Κενή διεύθυνση = ο ταμίας χρεώνει στο τερματικό και πληκτρολογεί την Ταυτότητα Συναλλαγής.">
                        <div class="row mt8">
                            <label string="Διεύθυνση" for="l10n_gr_prov_eft_driver_url" class="col-lg-4 o_light_label"/>
                            <field name="l10n_gr_prov_eft_driver_url" placeholder="http://megeftpos:8187"/>
                        </div>
                        <div class="row">
                            <label string="Username" for="l10n_gr_prov_eft_driver_user" class="col-lg-4 o_light_label"/>
                            <field name="l10n_gr_prov_eft_driver_user" placeholder="μόνο με BASIC_AUTH"/>
                        </div>
                        <div class="row" invisible="not l10n_gr_prov_eft_driver_user">
                            <label string="Password" for="l10n_gr_prov_eft_driver_password" class="col-lg-4 o_light_label"/>
                            <field name="l10n_gr_prov_eft_driver_password" password="True"/>
                        </div>
                    </setting>
                    <setting string="Άδεια Driver" name="l10n_gr_prov_eft_license_setting"
                             help="Το License Key της Mellon/ILYDA και ο ΑΦΜ στον οποίο εκδόθηκε. Κενός ΑΦΜ = ο ΑΦΜ της εταιρείας.">
                        <div class="row mt8">
                            <label string="License Key" for="l10n_gr_prov_eft_license_key" class="col-lg-4 o_light_label"/>
                            <field name="l10n_gr_prov_eft_license_key" password="True"/>
                        </div>
                        <div class="row">
                            <label string="ΑΦΜ Άδειας" for="l10n_gr_prov_eft_vat" class="col-lg-4 o_light_label"/>
                            <field name="l10n_gr_prov_eft_vat"/>
                        </div>
                    </setting>
                    <setting string="Τερματικά" name="l10n_gr_prov_eft_terminal_setting"
                             help="Τα τερματικά καρτών του καταστήματος. Από τη φόρμα κάθε τερματικού γίνεται και ο «Έλεγχος Driver».">
                        <button name="%(action_eft_terminal)d" type="action"
                                string="Τερματικά EFT/POS" class="btn-link" icon="oi-arrow-right"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
