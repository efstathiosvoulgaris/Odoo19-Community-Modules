<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Ανενεργό στην εγκατάσταση: ο φάκελος των addons είναι κοινός για test και skarlas,
         οπότε ενεργοποιείται χωριστά σε κάθε βάση. noupdate: αλλιώς κάθε upgrade
         το ξανασβήνει (έγινε στην 1.4). -->
    <record id="ir_cron_publish_by_stock" model="ir.cron">
        <field name="name">Eshop: δημοσίευση/απόσυρση με βάση το απόθεμα</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._qol_cron_publish_by_stock()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
