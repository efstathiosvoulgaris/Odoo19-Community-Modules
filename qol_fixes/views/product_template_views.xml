<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_no_auto_publish" model="ir.ui.view">
        <field name="name">product.template.form.no.auto.publish</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="qol_no_auto_publish" invisible="not is_storable or not sale_ok"/>
            </field>
        </field>
    </record>
</odoo>
